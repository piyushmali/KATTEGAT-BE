{
  "name": "kattegat-be",
  "version": "0.1.0",
  "private": true,
  "description": "KATTEGAT backend \u2014 discovery, evaluation and trust layer for autonomous agents on BNB Smart Chain",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:deployed": "bash -c 'set -a; . ./.env; . ./.env.deployed; DATABASE_URL=\"$DEPLOYED_EXTERNAL\"; set +a; exec tsx watch src/index.ts'",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "sync:agents": "tsx --env-file-if-exists=.env src/modules/ingestion/sync.cli.ts",
    "reclassify": "tsx --env-file-if-exists=.env src/modules/classification/reclassify.cli.ts",
    "verify:chain": "tsx --env-file-if-exists=.env scripts/verify-chain.ts",
    "altana:smoke": "tsx --env-file-if-exists=.env scripts/altana-smoke.ts",
    "erc8183:smoke": "tsx --env-file-if-exists=.env scripts/erc8183-smoke.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.8.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "viem": "2.56.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
