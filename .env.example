# KATTEGAT backend configuration.
# Copy to `.env` and adjust. Every variable below is validated at startup by
# src/config/env.ts — the process exits with a readable report if any are invalid.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kattegat

# ---------------------------------------------------------------------------
# BNB Smart Chain
# ---------------------------------------------------------------------------
# Primary RPC. Must support eth_getLogs — many public BSC endpoints do not.
# Verified working: bsc-rpc.publicnode.com, bsc.rpc.blxrbdn.com.
# Verified NOT usable for log scans: bsc-dataseed*.bnbchain.org and
# bsc-dataseed1.defibit.io ("limit exceeded"), bsc.meowrpc.com (method not
# supported), 1rpc.io/bnb (50-block cap), bsc.blockrazor.xyz (25-block cap).
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Second endpoint; the chain reader fails over on transport errors.
BSC_RPC_URL_FALLBACK=https://bsc.rpc.blxrbdn.com

# ---------------------------------------------------------------------------
# ERC-8004 registries
# ---------------------------------------------------------------------------
# These live at CREATE2-deterministic addresses and are byte-identical on every
# supported mainnet. Override only if you are pointing at a testnet or a fork.
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Block to start indexing `Registered` events from. The identity registry is not
# ERC721Enumerable (totalSupply reverts), so replaying `Registered` logs is the
# only way to discover agents. Leave at 0 to sync the most recent window.
ERC8004_DEPLOY_BLOCK=0

# eth_getLogs window size. 2000 works on the endpoints above.
ERC8004_LOG_CHUNK_SIZE=2000

# How far back a sync will reach. Free endpoints only retain a short window of
# logs — measured at roughly 8k blocks (~2h at BSC block times) on publicnode,
# with anything older returning an archive-access error. Raise this only when
# BSC_RPC_URL points at an archive-capable provider, otherwise every window in
# the extra range fails. Full historical backfill needs such a provider.
ERC8004_MAX_LOOKBACK_BLOCKS=8000

# Gateway used to resolve `ipfs://` agent registration files.
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# ---------------------------------------------------------------------------
# ERC-8004 Explorer REST API (optional enrichment, disabled by default)
# ---------------------------------------------------------------------------
# The QuickNode Explorer API is paywalled per request via x402 ($0.001 USDC on
# Base) and has no API key. KATTEGAT therefore treats it as optional enrichment
# on top of free on-chain reads. Enabling it requires a funded x402 signer.
ERC8004_EXPLORER_ENABLED=false
ERC8004_EXPLORER_BASE_URL=https://erc-8004.quicknode.com

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# Classification runs on a deterministic rule engine by default and needs no
# provider. Set this only to enable natural-language search parsing.
# Supported: none | openai-compatible
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Agent hiring (Altana) ------------------------------------------------
#
# Going live is these three values. No code change: chain id, explorer host,
# native token symbol and the Keystore address all derive from ALTANA_NETWORK
# and are carried to the browser through the API.
#
#   bnb-testnet   chain 97, free, the default
#   bnb           chain 56, real funds. Refused unless NODE_ENV=production.
ALTANA_NETWORK=bnb-testnet

# Gas faucet, NOT an authority.
#
# This key can send native tokens and nothing else. It cannot grant a session,
# cannot revoke one and cannot touch a user's funds: authority on an Altana
# wallet belongs to the passkey in the user's device.
#
# Leave empty to disable sponsorship. Hiring still works; the user funds their
# own gas.
#
# Measured cost of a full grant + act + revoke lifecycle: 962,143 gas, about
# 0.0000481 BNB (three US cents at BNB $600). The defaults below fund roughly
# twenty lifecycles per wallet and refuse an address that can already pay.
AGENT_GAS_SPONSOR_PRIVATE_KEY=
AGENT_GAS_SPONSOR_AMOUNT_WEI=1000000000000000
AGENT_GAS_SPONSOR_MAX_BALANCE_WEI=5000000000000000
